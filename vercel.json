{
 "trailingSlash": true,
 "headers": [
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/(.*)",
   "has": [
    {
     "type": "host",
     "value": "avij-qmj.vercel.app"
    }
   ],
   "destination": "/avij/$1"
  },
  {
   "source": "/(.*)",
   "has": [
    {
     "type": "host",
     "value": "shaikhieva-qmj.vercel.app"
    }
   ],
   "destination": "/shaikhieva/$1"
  },
  {
   "source": "/(.*)",
   "destination": "/sharapatova/$1"
  }
 ]
}